# Copy to beluga-signing.env and point each line at your own 1Password item.
# These are references, not secrets — op resolves them at build time and nothing
# is ever written to disk.
#
# Only notarization credentials are needed. The signing certificate itself is
# read from your login keychain (CSC_LINK / CSC_KEY_PASSWORD exist for CI, where
# there is no keychain), so it never has to leave it.
APPLE_ID=op://Private/Apple Developer/username
APPLE_APP_SPECIFIC_PASSWORD=op://Private/Apple Developer/beluga notarization password
APPLE_TEAM_ID=op://Private/Apple Developer/team id
